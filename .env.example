# 网站地址（本地开发）
NEXT_PUBLIC_SITE_URL=http://studysummarizer

# ===== DeepSeek（总结功能）=====
# 在 https://platform.deepseek.com/api_keys 获取 API Key
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 可选：总结模型（默认 deepseek-chat）
# DEEPSEEK_MODEL=deepseek-chat

# 可选：API 地址（一般不用改）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== OCR.space（扫描版 PDF 云端 OCR）=====
# 免费获取：https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=your-ocr-space-key-here

# 可选：OCR 语言（默认 auto 自动检测，中文文档也可设为 chs）
# OCR_LANGUAGE=auto

# ===== OpenAI（备选总结）=====
# 如果未配置 DEEPSEEK_API_KEY，会自动使用 OPENAI_API_KEY
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini
